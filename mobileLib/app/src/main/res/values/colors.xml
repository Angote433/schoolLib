         so both platforms feel like one product.
         ============================================================ -->

    <!-- Brand -->
    <color name="primary">#1B2B4B</color>
    <color name="primary_dark">#162038</color>
    <color name="primary_light">#2D4270</color>
    <color name="accent">#0D9488</color>
    <color name="accent_dark">#0B7A70</color>
    <color name="accent_light">#CCFBF1</color>

    <!-- Status -->
    <color name="danger">#DC2626</color>
    <color name="danger_light">#FEF2F2</color>
    <color name="warning">#D97706</color>
    <color name="warning_light">#FFFBEB</color>
    <color name="success">#16A34A</color>
    <color name="success_light">#F0FDF4</color>
    <color name="info">#1D4ED8</color>
