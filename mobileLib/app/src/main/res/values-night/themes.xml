<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark mode uses the same navy/teal brand palette — the primary
         color is already dark, so there is no separate "night" brand
         color needed. Surfaces stay light (off-white cards) intentionally:
         this is a fast-glance classroom tool used in daylight far more
         often than at night, and mixed light cards on a dark navy chrome
         keep contrast high in both cases. -->
    <style name="Theme.MobileLibApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_inverse</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/text_inverse</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:navigationBarColor">@color/card</item>
    </style>
</resources>
