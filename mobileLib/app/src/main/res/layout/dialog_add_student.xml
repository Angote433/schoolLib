<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admission Number"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etAdmission"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="e.g. ADM2025001"
        android:inputType="text"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etFullName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="e.g. John Mwangi"
        android:inputType="textPersonName|textCapWords"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Year Enrolled"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etYear"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:inputType="number"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp"/>

    <!-- Error text -->
    <TextView
        android:id="@+id/tvDialogError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/danger"
        android:background="@color/danger_light"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_marginTop="6dp"/>

</LinearLayout>
