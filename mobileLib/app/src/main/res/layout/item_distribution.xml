<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Book title -->
        <TextView
            android:id="@+id/tvDistBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"/>

        <!-- Barcode -->
        <TextView
            android:id="@+id/tvDistBarcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOOK-1-XXXXXXXX"
            android:textSize="11sp"
            android:textColor="#888888"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F2F5"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- Student info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDistStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/tvDistDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Issued: 2025-01-01"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <!-- Flag as lost button -->
            <Button
                android:id="@+id/btnFlagLost"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="⚠ Flag Lost"
                android:textSize="11sp"
                android:backgroundTint="#FFF5F5"
                android:textColor="#C53030"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>